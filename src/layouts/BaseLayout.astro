---
const {
  title = "Diego Barrio H. — Senior Backend Engineer",
  description = "Senior Backend Engineer. Java, Spring Boot, microservicios y observabilidad para banca, fintech y movilidad. 15+ años entregando software en producción.",
  // Standalone pages duplicate the home sections; keep them reachable but out of
  // Google's index. Home is the single canonical URL for search.
  noindex = false,
} = Astro.props;

const SITE_URL = "https://diegobarrioh.dev";

// Per-page canonical / OG url — derived from the current path, not hardcoded to home.
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? SITE_URL).href;

// Google Search Console "HTML tag" verification token. Paste the `content`
// value from Search Console → Settings → Ownership verification → HTML tag.
// Leave empty once ownership is confirmed (or keep it — harmless).
const GOOGLE_SITE_VERIFICATION = "";

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Diego Barrio H.",
  url: SITE_URL,
  image: `${SITE_URL}/img/dbh-wall.jpg`,
  jobTitle: "Senior Backend Engineer",
  email: "diegobarrioh@gmail.com",
  sameAs: ["https://www.linkedin.com/in/diegobarrioh", "https://github.com/guilu", "https://x.com/guilu"],
  knowsAbout: ["Java", "Spring Boot", "Microservices", "Event-driven architecture", "AWS", "Kubernetes", "Apache Kafka"],
};
---

<!doctype html>
<html lang="es" data-lang="es" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />


    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="color-scheme" content="dark light" />
    <title>{title}</title>

    {GOOGLE_SITE_VERIFICATION && <meta name="google-site-verification" content={GOOGLE_SITE_VERIFICATION} />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={`${SITE_URL}/img/og-cover.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Diego Barrio H. — Senior Backend & Platform Engineer" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${SITE_URL}/img/og-cover.png`} />
    <meta name="twitter:image:alt" content="Diego Barrio H. — Senior Backend & Platform Engineer" />

    <link rel="icon" type="image/svg+xml" href="/img/dbh2-black.svg" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="preload" href="/fonts/Geist-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/IBMPlexMono-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/styles.css" />

    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />

    <!-- Apply stored theme/lang before first paint (no flash) -->
    <script is:inline>
      (() => {
        const root = document.documentElement;
        root.classList.add("js");
        const params = new URLSearchParams(location.search);
        const theme =
          params.get("theme") ||
          localStorage.getItem("theme") ||
          (window.matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark");
        root.setAttribute("data-theme", theme);
        const lang =
          params.get("lang") ||
          localStorage.getItem("lang") ||
          ((navigator.language || "en").toLowerCase().startsWith("es") ? "es" : "en");
        root.setAttribute("data-lang", lang);
        root.setAttribute("lang", lang);
      })();
    </script>
  </head>

  <body>
    <slot />
    <section class="consent-banner" data-consent-banner hidden aria-labelledby="consent-title" aria-describedby="consent-description">
      <div class="consent-copy">
        <h2 id="consent-title">
          <span class="i18n" data-lang="es">Analítica opcional</span>
          <span class="i18n" data-lang="en">Optional analytics</span>
        </h2>
        <p id="consent-description">
          <span class="i18n" data-lang="es">¿Permites analítica anónima para mejorar esta web? No se carga Google Tag Manager hasta que aceptes.</span>
          <span class="i18n" data-lang="en">Allow anonymous analytics to improve this site? Google Tag Manager is not loaded until you accept.</span>
        </p>
      </div>
      <div class="consent-actions">
        <button class="btn ghost" type="button" data-consent-deny>
          <span class="i18n inline" data-lang="es">Rechazar</span><span class="i18n inline" data-lang="en">Reject</span>
        </button>
        <button class="btn primary" type="button" data-consent-grant>
          <span class="i18n inline" data-lang="es">Aceptar</span><span class="i18n inline" data-lang="en">Accept</span>
        </button>
      </div>
    </section>
    <script>
      import { createAnalyticsConsent, getAnalyticsConsent } from "../scripts/analytics-consent.js";
      import { initIntentAnalytics } from "../scripts/intent-analytics.js";

      const analyticsWindow = window as typeof window & {
        dataLayer?: Record<string, unknown>[];
      };

      analyticsWindow.dataLayer = analyticsWindow.dataLayer || [];
      const consent = createAnalyticsConsent({ window, document, storage: localStorage, gtmId: "GTM-WVNMFKK3" });
      const banner = document.querySelector<HTMLElement>("[data-consent-banner]");
      const showBanner = () => { if (banner) banner.hidden = false; };
      const hideBanner = () => { if (banner) banner.hidden = true; };
      consent.start();
      if (getAnalyticsConsent(localStorage) === null) showBanner();
      document.querySelector("[data-consent-grant]")?.addEventListener("click", () => { consent.grant(); hideBanner(); });
      document.querySelector("[data-consent-deny]")?.addEventListener("click", () => { consent.deny(); hideBanner(); });
      document.querySelectorAll("[data-consent-settings]").forEach((button) => button.addEventListener("click", showBanner));

      initIntentAnalytics({
        document,
        dataLayer: analyticsWindow.dataLayer,
        hasAnalyticsConsent: consent.hasGranted,
      });
    </script>
    <script>
      const root = document.documentElement;
      const toggle = document.getElementById("theme-toggle");
      const langToggle = document.getElementById("lang-toggle");

      const applyTheme = (theme: string) => {
        root.setAttribute("data-theme", theme);
        localStorage.setItem("theme", theme);
      };

      const applyLang = (lang: string) => {
        root.setAttribute("data-lang", lang);
        root.setAttribute("lang", lang);
        localStorage.setItem("lang", lang);
        langToggle?.setAttribute("aria-label", lang === "es" ? "Switch to English" : "Cambiar a español");
      };

      toggle?.addEventListener("click", () => {
        applyTheme(root.getAttribute("data-theme") === "light" ? "dark" : "light");
      });

      langToggle?.addEventListener("click", () => {
        applyLang(root.getAttribute("data-lang") === "es" ? "en" : "es");
      });

      // Scroll reveal — show elements as they enter the viewport
      const revealEls = document.querySelectorAll(".reveal");
      if ("IntersectionObserver" in window && revealEls.length) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("in");
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.1 }
        );
        revealEls.forEach((el) => io.observe(el));
      } else {
        revealEls.forEach((el) => el.classList.add("in"));
      }

      // Scrollspy — highlight the nav link of the section in view
      const navLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>(".nav-links a[href*='#']"));
      const sections = navLinks
        .map((link) => document.getElementById(link.hash.slice(1)))
        .filter((s): s is HTMLElement => Boolean(s));

      if ("IntersectionObserver" in window && sections.length) {
        const spy = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              navLinks.forEach((link) => {
                link.classList.toggle("active", link.hash === `#${entry.target.id}`);
              });
            }
          },
          { rootMargin: "-40% 0px -55% 0px" }
        );
        sections.forEach((s) => spy.observe(s));
      }
    </script>
  </body>
</html>
