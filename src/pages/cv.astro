---

<BaseLayout title="CV — Diego Barrio H.">
  <Nav current="cv" />
  <main class="container">
    <article class="cv-doc">
      <header class="cv-head">
        <h1>Diego Barrio Hortigüela</h1>
        <p class="cv-role">
          <span class="i18n inline" data-lang="es">{roleEs}</span>
          <span class="i18n inline" data-lang="en">{roleEn}</span>
        </p>
        <p class="cv-tagline">
          <span class="i18n inline" data-lang="es">{taglineEs}</span>
          <span class="i18n inline" data-lang="en">{taglineEn}</span>
        </p>
        <p class="cv-contact">
          {contact.map((c, i) => (
            <>
              {i > 0 && <span class="cv-sep" aria-hidden="true">·</span>}
              {c.href ? (
                <a href={c.href} target={c.href.startsWith("http") ? "_blank" : undefined} rel={c.href.startsWith("http") ? "noreferrer" : undefined}>
                  <span class="i18n inline" data-lang="es">{c.labelEs}</span>
                  <span class="i18n inline" data-lang="en">{c.labelEn}</span>
                </a>
              ) : (
                <>
                  <span class="i18n inline" data-lang="es">{c.labelEs}</span>
                  <span class="i18n inline" data-lang="en">{c.labelEn}</span>
                </>
              )}
            </>
          ))}
        </p>
        <div class="btns cv-actions">
          <a class="btn primary" href="/pdf/diegobarrioh_mk4.pdf" target="_blank" rel="noreferrer">
            <span class="i18n inline" data-lang="es">Abrir CV en PDF</span>
            <span class="i18n inline" data-lang="en">Open CV PDF</span>
          </a>
          <a class="btn" href="/">
            <span class="i18n inline" data-lang="es">Volver</span>
            <span class="i18n inline" data-lang="en">Back</span>
          </a>
        </div>
      </header>

      <hr />
      <h2>
        <span class="cv-emoji" aria-hidden="true">🧑‍💻</span>
        <span class="i18n inline" data-lang="es">Perfil</span>
        <span class="i18n inline" data-lang="en">About</span>
      </h2>
      <p class="i18n" data-lang="es">{summary.es}</p>
      <p class="i18n" data-lang="en">{summary.en}</p>

      <hr />
      <h2>
        <span class="cv-emoji" aria-hidden="true">🛠️</span>
        <span class="i18n inline" data-lang="es">Competencias clave</span>
        <span class="i18n inline" data-lang="en">Core Competencies</span>
      </h2>
      {competencies.map((c) => (
        <>
          <h3>
            <span class="i18n inline" data-lang="es">{c.titleEs}</span>
            <span class="i18n inline" data-lang="en">{c.titleEn}</span>
          </h3>
          <ul>{c.items.map((s) => <li>{s}</li>)}</ul>
        </>
      ))}

      <hr />
      <h2>
        <span class="cv-emoji" aria-hidden="true">🚀</span>
        <span class="i18n inline" data-lang="es">Proyectos destacados</span>
        <span class="i18n inline" data-lang="en">Featured Projects</span>
      </h2>
      {projects.map((p) => (
        <>
          <h3>
            {p.url ? (
              <a href={p.url} target="_blank" rel="noreferrer">{p.name}</a>
            ) : (
              p.name
            )}
          </h3>
          <p class="cv-sub">
            <span class="i18n inline" data-lang="es">{p.subEs}</span>
            <span class="i18n inline" data-lang="en">{p.subEn}</span>
          </p>
          <p>
            <span class="i18n inline" data-lang="es">{p.descEs}</span>
            <span class="i18n inline" data-lang="en">{p.descEn}</span>
          </p>
          <ul>
            {p.bullets.map((b) => (
              <li>
                <span class="i18n inline" data-lang="es">{b.es}</span>
                <span class="i18n inline" data-lang="en">{b.en}</span>
              </li>
            ))}
          </ul>
          {p.hwEs && (
            <p class="cv-tech">
              <strong>Hardware:</strong>
              <span class="i18n inline" data-lang="es"> {p.hwEs}</span>
              <span class="i18n inline" data-lang="en"> {p.hwEn}</span>
            </p>
          )}
          {p.stack.length > 0 && (
            <p class="cv-tech">
              <strong>
                <span class="i18n inline" data-lang="es">Tecnologías:</span>
                <span class="i18n inline" data-lang="en">Technologies:</span>
              </strong>
              <span> {p.stack.join(", ")}</span>
            </p>
          )}
        </>
      ))}

      <hr />
      <h2>
        <span class="cv-emoji" aria-hidden="true">💼</span>
        <span class="i18n inline" data-lang="es">Experiencia profesional</span>
        <span class="i18n inline" data-lang="en">Professional Experience</span>
      </h2>
      {experience.map((e) => (
        <>
          <h3>
            <span class="i18n inline" data-lang="es">{e.roleEs}</span>
            <span class="i18n inline" data-lang="en">{e.roleEn}</span>
          </h3>
          <p class="cv-meta">
            <span class="cv-company">{e.company}</span>
            <span class="cv-sep" aria-hidden="true">·</span>
            <span class="i18n inline" data-lang="es">{e.periodEs}</span>
            <span class="i18n inline" data-lang="en">{e.periodEn}</span>
          </p>
          <ul>
            {e.bullets.map((b) => (
              <li>
                <span class="i18n inline" data-lang="es">{b.es}</span>
                <span class="i18n inline" data-lang="en">{b.en}</span>
              </li>
            ))}
          </ul>
          <p class="cv-tech">
            <strong>
              <span class="i18n inline" data-lang="es">Tecnologías:</span>
              <span class="i18n inline" data-lang="en">Technologies:</span>
            </strong>
            <span> {e.stack.join(", ")}</span>
          </p>
        </>
      ))}

      <hr />
      <h2>
        <span class="cv-emoji" aria-hidden="true">🎓</span>
        <span class="i18n inline" data-lang="es">Educación</span>
        <span class="i18n inline" data-lang="en">Education</span>
      </h2>
      {education.map((e) => (
        <>
          <h3>
            <span class="i18n inline" data-lang="es">{e.titleEs}</span>
            <span class="i18n inline" data-lang="en">{e.titleEn}</span>
          </h3>
          <p class="cv-meta">
            <span class="cv-company">{e.org}</span>
            <span class="cv-sep" aria-hidden="true">·</span>
            <span class="i18n inline" data-lang="es">{e.periodEs}</span>
            <span class="i18n inline" data-lang="en">{e.periodEn}</span>
          </p>
          {e.noteEs && (
            <p>
              <span class="i18n inline" data-lang="es">{e.noteEs}</span>
              <span class="i18n inline" data-lang="en">{e.noteEn}</span>
            </p>
          )}
        </>
      ))}

      <hr />
      <h2>
        <span class="cv-emoji" aria-hidden="true">🤝</span>
        <span class="i18n inline" data-lang="es">Comunidad y proyectos personales</span>
        <span class="i18n inline" data-lang="en">Community & Personal Projects</span>
      </h2>
      <ul>
        {community.map((c) => (
          <li>
            <span class="i18n inline" data-lang="es">{c.es}</span>
            <span class="i18n inline" data-lang="en">{c.en}</span>
          </li>
        ))}
      </ul>

      <hr />
      <h2>
        <span class="cv-emoji" aria-hidden="true">📚</span>
        <span class="i18n inline" data-lang="es">En aprendizaje</span>
        <span class="i18n inline" data-lang="en">Learning Focus</span>
      </h2>
      <ul>{learning.map((s) => <li>{s}</li>)}</ul>

      <hr />
      <h2>
        <span class="cv-emoji" aria-hidden="true">🗣️</span>
        <span class="i18n inline" data-lang="es">Idiomas</span>
        <span class="i18n inline" data-lang="en">Languages</span>
      </h2>
      <table class="cv-table">
        <thead>
          <tr>
            <th>
              <span class="i18n inline" data-lang="es">Idioma</span>
              <span class="i18n inline" data-lang="en">Language</span>
            </th>
            <th>
              <span class="i18n inline" data-lang="es">Nivel</span>
              <span class="i18n inline" data-lang="en">Level</span>
            </th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>
              <span class="i18n inline" data-lang="es">Español</span>
              <span class="i18n inline" data-lang="en">Spanish</span>
            </td>
            <td>
              <span class="i18n inline" data-lang="es">Nativo</span>
              <span class="i18n inline" data-lang="en">Native</span>
            </td>
          </tr>
          <tr>
            <td>
              <span class="i18n inline" data-lang="es">Inglés</span>
              <span class="i18n inline" data-lang="en">English</span>
            </td>
            <td>
              <span class="i18n inline" data-lang="es">Competencia profesional plena (C1)</span>
              <span class="i18n inline" data-lang="en">Full Professional Proficiency (C1)</span>
            </td>
          </tr>
        </tbody>
      </table>
    </article>
  </main>
</BaseLayout>
