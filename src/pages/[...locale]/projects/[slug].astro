---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Nav from "../../../components/Nav.astro";
import { getContent, localizePath, locales, type Locale } from "../../../i18n";

export function getStaticPaths() {
  return locales.flatMap((locale) =>
    getContent(locale).projects.pages.map((page) => ({
      params: { locale: locale === "en" ? undefined : locale, slug: page.slug },
      props: { locale, slug: page.slug },
    }))
  );
}

const { locale, slug } = Astro.props as { locale: Locale; slug: string };
const c = getContent(locale);
const t = c.projects;
const project = t.pages.find((p) => p.slug === slug)!;
const PATH = `/projects/${slug}/`;
---

<BaseLayout locale={locale} path={PATH} title={project.metaTitle} description={project.metaDescription}>
  <Nav locale={locale} path={PATH} current="projects" />
  <main class="container">
    <article class="cv-doc">
      <header class="cv-head">
        <p class="eyebrow">
          <a href={localizePath("/projects/", locale)}>← {t.backToProjects}</a>
        </p>
        <h1>{project.name}</h1>
        <p class="cv-tagline">{project.tagline}</p>
        <p class="cv-meta">
          <span class="cv-company">{t.statusLabel}</span>
          <span class="cv-sep" aria-hidden="true">·</span>
          <span>{project.status}</span>
        </p>
        {project.url && (
          <div class="btns cv-actions">
            <a class="btn primary" href={project.url} target="_blank" rel="noopener noreferrer">
              {t.visitSite}
            </a>
          </div>
        )}
      </header>

      {project.sections.map((section) => (
        <>
          <hr />
          <h2>{section.title}</h2>
          {section.body.map((paragraph) => <p>{paragraph}</p>)}
        </>
      ))}

      <hr />
      <h2>{t.stackLabel}</h2>
      <div class="taglist">{project.stack.map((s) => <span class="pill">{s}</span>)}</div>
    </article>
  </main>
</BaseLayout>
