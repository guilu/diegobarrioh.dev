---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";

const socials = [
  {
    ico: "in",
    label: "LinkedIn",
    handle: "in/diegobarrioh",
    href: "https://www.linkedin.com/in/diegobarrioh",
  },
  {
    ico: "gh",
    label: "GitHub",
    handle: "github.com/guilu",
    href: "https://github.com/guilu",
  },
  {
    ico: "✕",
    label: "X / Twitter",
    handle: "x.com/guilu",
    href: "https://x.com/guilu",
  },
  {
    ico: "@",
    label: "Email",
    handle: "diegobarrioh@gmail.com",
    href: "mailto:diegobarrioh@gmail.com",
  },
];

const metrics = [
  {
    value: "15+",
    labelEs: "años entregando software en producción",
    labelEn: "years shipping production software",
  },
  {
    value: "4",
    labelEs: "sectores críticos: banca, fintech, movilidad, enterprise",
    labelEn: "critical industries: banking, fintech, mobility, enterprise",
  },
  {
    value: "100%",
    labelEs: "foco backend: arquitectura, calidad y observabilidad",
    labelEn: "backend focus: architecture, quality, observability",
  },
];

const companies = ["Europcar Mobility Group", "Accenture", "Banco Sabadell", "SABIS", "Caja Mediterráneo"];

const skillsGroups = [
  {
    titleEs: "Backend Core",
    titleEn: "Backend Core",
    items: ["Java", "Spring Boot", "Spring MVC", "Spring Security", "JPA/Hibernate", "REST APIs"],
  },
  {
    titleEs: "Arquitectura y escalado",
    titleEn: "Architecture & Scale",
    items: ["Microservices", "DDD", "Hexagonal", "Event-driven", "Clean Architecture", "SRE mindset"],
  },
  {
    titleEs: "Cloud y plataforma",
    titleEn: "Cloud & Platform",
    items: ["AWS", "Kubernetes", "Docker", "Apache Kafka", "CI/CD", "GitLab/Jenkins"],
  },
  {
    titleEs: "Data y observabilidad",
    titleEn: "Data & Observability",
    items: ["PostgreSQL", "Oracle", "SQL Server", "MongoDB", "Grafana", "Splunk/Sentry"],
  },
];

const highlights = [
  {
    titleEs: "APIs de facturación y pagos",
    titleEn: "Billing & Payments APIs",
    textEs: "Diseño de APIs críticas para movilidad, con arquitectura orientada a eventos, observabilidad operativa y despliegues cloud-native.",
    textEn: "Designed mission-critical mobility billing APIs with event-driven architecture, operational observability, and cloud-native delivery.",
    stack: ["Java", "Spring Boot", "Kafka", "AWS", "Kubernetes"],
  },
  {
    titleEs: "Modernización de core bancario",
    titleEn: "Core Banking Modernization",
    textEs: "Migración de procesos bancarios a servicios modulares, mejorando rendimiento, trazabilidad y time-to-market.",
    textEn: "Migrated core banking processes to modular services, improving performance, traceability, and time-to-market.",
    stack: ["Spring", "Hibernate", "Oracle", "SQL Server", "CI/CD"],
  },
  {
    titleEs: "Plataformas enterprise",
    titleEn: "Enterprise Platforms",
    textEs: "Construcción de plataformas e integraciones para equipos internos, reduciendo fricción operativa y deuda técnica.",
    textEn: "Built internal platforms and integrations that reduced operational friction and technical debt.",
    stack: ["Spring MVC", "JPA", "SharePoint", ".NET", "Oracle"],
  },
];

const experience = [
  {
    periodEs: "2024 — Hoy",
    periodEn: "2024 — Present",
    current: true,
    roleEs: "Senior Backend Engineer",
    roleEn: "Senior Backend Engineer",
    company: "Mindden / Europcar Mobility Group",
    impactEs: "Desarrollo de APIs de negocio crítico para pagos y facturación, reforzando robustez operativa y velocidad de entrega.",
    impactEn: "Built business-critical billing and payments APIs, strengthening operational robustness and delivery velocity.",
    stack: ["Java", "Spring Boot", "Kafka", "AWS", "Kubernetes"],
  },
  {
    periodEs: "2022 — 2024",
    periodEn: "2022 — 2024",
    roleEs: "Senior Analyst",
    roleEn: "Senior Analyst",
    company: "Accenture",
    impactEs: "Microservicios y optimización de datos para banca, con foco en rendimiento, uptime y mantenibilidad.",
    impactEn: "Delivered microservices and data optimization for banking with focus on performance, uptime, and maintainability.",
    stack: ["Java", "Spring", "Microservices", "Oracle"],
  },
  {
    periodEs: "2014 — 2022",
    periodEn: "2014 — 2022",
    roleEs: "Senior Specialist",
    roleEn: "Senior Specialist",
    company: "SABIS",
    impactEs: "Diseño de plataformas enterprise e integraciones internas para estandarizar flujos entre equipos.",
    impactEn: "Designed enterprise platforms and internal integrations to standardize workflows across teams.",
    stack: ["Spring MVC", "JPA", "SharePoint", ".NET"],
  },
  {
    periodEs: "2007 — 2014",
    periodEn: "2007 — 2014",
    roleEs: "Analyst / Developer",
    roleEn: "Analyst / Developer",
    company: "Banco Sabadell · Caja Mediterráneo",
    impactEs: "Evolución de plataformas transaccionales en banca online y servicios ATM de alta criticidad.",
    impactEn: "Evolved high-criticality online banking and ATM transactional platforms.",
    stack: ["Java", "Banca online", "ATM"],
  },
];
---

<BaseLayout title="Diego Barrio H. — Senior Backend Engineer · Java & Spring">
  <Nav current="home" />
  <main>
    <header class="hero" id="home">
      <div class="container">
        <div class="hero-grid">
          <div class="hero-copy">
            <p class="hero-status">
              <span class="status-dot" aria-hidden="true"></span>
              <span class="i18n inline" data-lang="es">Disponible para roles senior</span>
              <span class="i18n inline" data-lang="en">Open to senior roles</span>
            </p>
            <h1>
              <span class="hero-name">Diego Barrio H.</span>
              <span class="hero-role">
                <span class="i18n inline" data-lang="es">Senior Backend Engineer · Java & Spring</span>
                <span class="i18n inline" data-lang="en">Senior Backend Engineer · Java & Spring</span>
              </span>
            </h1>
            <p class="hero-lead i18n" data-lang="es">
              15+ años construyendo plataformas backend escalables, mantenibles y observables para banca, fintech y movilidad. Arquitectura moderna para productos que no pueden fallar.
            </p>
            <p class="hero-lead i18n" data-lang="en">
              15+ years building scalable, maintainable, and observable backend platforms for banking, fintech, and mobility. Modern architecture for products that cannot fail.
            </p>

            <div class="hero-actions">
              <a class="btn primary" href="/pdf/diegobarrioh_mk4.pdf" target="_blank" rel="noopener noreferrer">
                <span class="i18n inline" data-lang="es">Ver CV en PDF</span>
                <span class="i18n inline" data-lang="en">Open CV PDF</span>
              </a>
              <a class="btn" href="https://www.linkedin.com/in/diegobarrioh" target="_blank" rel="noopener noreferrer">LinkedIn</a>
              <a class="btn ghost" href="#contact">
                <span class="i18n inline" data-lang="es">Hablemos</span>
                <span class="i18n inline" data-lang="en">Let's talk</span>
              </a>
            </div>
          </div>

          <figure class="hero-figure" aria-hidden="false">
            <img
              class="hero-portrait"
              src="/img/dbh-wall.jpg"
              alt="Retrato de Diego Barrio H."
              width="340"
              height="425"
              fetchpriority="high"
            />
          </figure>
        </div>

        <div class="hero-metrics">
          {metrics.map((m) => (
            <div class="metric">
              <p class="metric-value">{m.value}</p>
              <p class="metric-label">
                <span class="i18n inline" data-lang="es">{m.labelEs}</span>
                <span class="i18n inline" data-lang="en">{m.labelEn}</span>
              </p>
            </div>
          ))}
        </div>

        <div class="hero-companies">
          <span class="companies-label">
            <span class="i18n inline" data-lang="es">Trayectoria en</span>
            <span class="i18n inline" data-lang="en">Track record at</span>
          </span>
          {companies.map((c) => <span class="company">{c}</span>)}
        </div>
      </div>
    </header>

    <section class="section" id="experience">
      <div class="container">
        <div class="section-head reveal">
          <span class="sec-num">01</span>
          <h2>
            <span class="i18n inline" data-lang="es">Experiencia en sistemas que no pueden fallar.</span>
            <span class="i18n inline" data-lang="en">Experience in systems that cannot fail.</span>
          </h2>
          <span class="section-kicker">
            <span class="i18n inline" data-lang="es">Experiencia</span>
            <span class="i18n inline" data-lang="en">Experience</span>
          </span>
        </div>
        <div class="timeline">
          {experience.map((item) => (
            <div class="tl-item reveal">
              <div class="tl-period">
                <span class="i18n inline" data-lang="es">{item.periodEs}</span>
                <span class="i18n inline" data-lang="en">{item.periodEn}</span>
                {item.current && (
                  <span class="tl-current">
                    <span class="i18n inline" data-lang="es">● Actual</span>
                    <span class="i18n inline" data-lang="en">● Current</span>
                  </span>
                )}
              </div>
              <div>
                <div class="tl-role">
                  <span class="i18n inline" data-lang="es">{item.roleEs}</span>
                  <span class="i18n inline" data-lang="en">{item.roleEn}</span>
                </div>
                <div class="tl-company">{item.company}</div>
                <div class="tl-impact">
                  <span class="i18n inline" data-lang="es">{item.impactEs}</span>
                  <span class="i18n inline" data-lang="en">{item.impactEn}</span>
                </div>
                <div class="taglist">{item.stack.map((s) => <span class="pill">{s}</span>)}</div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section" id="projects">
      <div class="container">
        <div class="section-head reveal">
          <span class="sec-num">02</span>
          <h2>
            <span class="i18n inline" data-lang="es">Trabajo real en dominios complejos.</span>
            <span class="i18n inline" data-lang="en">Real work in complex domains.</span>
          </h2>
          <span class="section-kicker">
            <span class="i18n inline" data-lang="es">Proyectos</span>
            <span class="i18n inline" data-lang="en">Projects</span>
          </span>
        </div>
        <div class="proj-list">
          {highlights.map((h, i) => (
            <article class="proj reveal">
              <span class="proj-num">{String(i + 1).padStart(2, "0")}</span>
              <h3>
                <span class="i18n inline" data-lang="es">{h.titleEs}</span>
                <span class="i18n inline" data-lang="en">{h.titleEn}</span>
              </h3>
              <span class="proj-arrow" aria-hidden="true">→</span>
              <p>
                <span class="i18n inline" data-lang="es">{h.textEs}</span>
                <span class="i18n inline" data-lang="en">{h.textEn}</span>
              </p>
              <div class="taglist">{h.stack.map((s) => <span class="pill">{s}</span>)}</div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section" id="skills">
      <div class="container">
        <div class="section-head reveal">
          <span class="sec-num">03</span>
          <h2>
            <span class="i18n inline" data-lang="es">Tecnologías y prácticas para escalar producto y equipo.</span>
            <span class="i18n inline" data-lang="en">Technologies and practices to scale both product and team.</span>
          </h2>
          <span class="section-kicker">Stack</span>
        </div>
        <div class="stack-grid">
          {skillsGroups.map((group) => (
            <div class="stack-group reveal">
              <h3>
                <span class="i18n inline" data-lang="es">{group.titleEs}</span>
                <span class="i18n inline" data-lang="en">{group.titleEn}</span>
              </h3>
              <div class="taglist">{group.items.map((item) => <span class="pill">{item}</span>)}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section" id="lab">
      <div class="container">
        <div class="section-head reveal">
          <span class="sec-num">04</span>
          <h2>
            <span class="i18n inline" data-lang="es">Laboratorio: cómo pienso y cómo construyo.</span>
            <span class="i18n inline" data-lang="en">Lab: how I think and how I build.</span>
          </h2>
          <span class="section-kicker">Lab</span>
        </div>
        <div class="lab reveal">
          <div>
            <p class="i18n" data-lang="es">
              Un espacio donde documento proyectos personales, decisiones de arquitectura y experimentos orientados a resolver problemas reales.
            </p>
            <p class="i18n" data-lang="en">
              A place where I document personal projects, architecture decisions, and experiments aimed at solving real problems.
            </p>
          </div>
          <a class="lab-cta" href="https://backendtothefuture.com" target="_blank" rel="noopener noreferrer" aria-label="backendtothefuture.com">
            <img class="lab-cta-logo" src="/img/bttf-logo.svg" alt="" width="44" height="44" loading="lazy" />
            <span class="lab-cta-text">
              <b>BACKEND</b>
              <span>To the future</span>
            </span>
          </a>
        </div>
      </div>
    </section>

    <section class="section" id="contact">
      <div class="container">
        <div class="section-head reveal">
          <span class="sec-num">05</span>
          <h2>
            <span class="i18n inline" data-lang="es">¿Construimos algo que no pueda fallar?</span>
            <span class="i18n inline" data-lang="en">Let's build something that cannot fail.</span>
          </h2>
          <span class="section-kicker">
            <span class="i18n inline" data-lang="es">Contacto</span>
            <span class="i18n inline" data-lang="en">Contact</span>
          </span>
        </div>

        <p class="contact-lead i18n reveal" data-lang="es">
          Disponible para nuevos proyectos, consultoría y roles senior de backend. Respuesta en menos de 24 horas.
        </p>
        <p class="contact-lead i18n reveal" data-lang="en">
          Available for new projects, consulting engagements, and senior backend roles. I reply within 24 hours.
        </p>

        <a class="contact-mail reveal" href="mailto:diegobarrioh@gmail.com">diegobarrioh@gmail.com</a>

        <div class="contact-cta reveal">
          <a class="btn primary" href="https://calendly.com/diegobarrioh/30min" target="_blank" rel="noreferrer">
            <span class="i18n inline" data-lang="es">Reservar 30 min en Calendly</span>
            <span class="i18n inline" data-lang="en">Book 30 min on Calendly</span>
          </a>
        </div>

        <div class="contact-rows">
          {socials.map((s) => (
            <a class="crow reveal" href={s.href} target="_blank" rel="noreferrer">
              <span class="crow-ico">{s.ico}</span>
              <span class="crow-info">
                <b>{s.label}</b>
                <span>{s.handle}</span>
              </span>
              <span class="crow-cta">
                <span class="i18n inline" data-lang="es">Abrir</span>
                <span class="i18n inline" data-lang="en">Open</span>
                {" "}→
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <footer class="footer">
      <div class="container footer-inner">
        <span>
          <span class="i18n inline" data-lang="es">
            © {new Date().getFullYear()} Diego Barrio H. · Backend Engineering con foco en calidad, arquitectura y entrega.
          </span>
          <span class="i18n inline" data-lang="en">
            © {new Date().getFullYear()} Diego Barrio H. · Backend Engineering focused on quality, architecture, and delivery.
          </span>
        </span>
        <span class="footer-links">
          <a href="https://www.linkedin.com/in/diegobarrioh" target="_blank" rel="noreferrer">LinkedIn</a>
          <a href="https://github.com/guilu" target="_blank" rel="noreferrer">GitHub</a>
          <a href="/pdf/diegobarrioh_mk4.pdf" target="_blank" rel="noreferrer">CV</a>
        </span>
      </div>
    </footer>
  </main>
</BaseLayout>
