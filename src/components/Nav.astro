---
const { current } = Astro.props;

const links = [
  { href: "/#home", labelEs: "Inicio", labelEn: "Home", key: "home" },
  { href: "/#experience", labelEs: "Experiencia", labelEn: "Experience", key: "experience" },
  { href: "/#projects", labelEs: "Proyectos", labelEn: "Projects", key: "projects" },
  { href: "/#skills", labelEs: "Stack", labelEn: "Stack", key: "skills" },
  { href: "/#lab", labelEs: "Lab", labelEn: "Lab", key: "lab" },
  { href: "/#contact", labelEs: "Contacto", labelEn: "Contact", key: "contact" },
];
---

<nav class="nav" data-nav-root>
  <div class="container nav-inner">
    <a href="/#home" class="brand">
      <img src="/img/dbh2-white.svg" alt="Diego Barrio H. logo" class="brand-logo logo-dark" />
      <img src="/img/dbh2-black.svg" alt="Diego Barrio H. logo" class="brand-logo logo-light" />
      <span class="brand-name">Diego Barrio H.</span>
    </a>

    <div class="nav-panel" id="primary-menu">
      <div class="nav-links">
        {links.map((l) => (
          <a href={l.href} class={current === l.key ? "active" : ""}>
            <span class="i18n inline" data-lang="es">{l.labelEs}</span>
            <span class="i18n inline" data-lang="en">{l.labelEn}</span>
          </a>
        ))}
      </div>
    </div>

    <div class="nav-actions">
      <a class="btn primary nav-cv" href="/pdf/diegobarrioh_mk4.pdf" target="_blank" rel="noopener noreferrer">CV</a>
      <button class="toggle lang-toggle" type="button" id="lang-toggle" aria-label="Cambiar idioma">
        <span class="opt" data-value="es">ES</span>
        <span class="opt" data-value="en">EN</span>
      </button>
      <button class="toggle theme-toggle" type="button" id="theme-toggle" aria-label="Cambiar tema">
        <span class="opt" data-value="light">☀</span>
        <span class="opt" data-value="dark">☾</span>
      </button>
    </div>

    <button class="menu-toggle" type="button" data-menu-toggle aria-expanded="false" aria-controls="primary-menu" aria-label="Abrir menu de navegacion">
      <span class="menu-toggle-line"></span>
      <span class="menu-toggle-line"></span>
      <span class="menu-toggle-line"></span>
    </button>
  </div>
</nav>

<script is:inline>
  const nav = document.querySelector("[data-nav-root]");

  if (nav) {
    const toggleButton = nav.querySelector("[data-menu-toggle]");
    const navLinks = nav.querySelectorAll(".nav-links a");

    const setExpanded = (expanded) => {
      nav.classList.toggle("is-open", expanded);
      if (toggleButton) {
        toggleButton.setAttribute("aria-expanded", expanded ? "true" : "false");
        toggleButton.setAttribute("aria-label", expanded ? "Cerrar menu de navegacion" : "Abrir menu de navegacion");
      }
    };

    toggleButton?.addEventListener("click", () => {
      setExpanded(!nav.classList.contains("is-open"));
    });

    navLinks.forEach((link) => {
      link.addEventListener("click", () => {
        setExpanded(false);
      });
    });

    window.addEventListener("resize", () => {
      if (window.innerWidth > 820) {
        setExpanded(false);
      }
    });
  }
</script>
