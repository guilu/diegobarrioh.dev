---
import { defaultLocale, getContent, localizePath, locales, type Locale } from "../i18n";

interface Props {
  locale: Locale;
  /** Canonical, locale-free path of the page rendering this nav. */
  path: string;
  current?: string;
}

const { locale, path, current } = Astro.props;
const t = getContent(locale).nav;

const home = localizePath("/", locale);
const links = [
  { hash: "#home", label: t.home, key: "home" },
  { hash: "#experience", label: t.experience, key: "experience" },
  { hash: "#projects", label: t.projects, key: "projects" },
  { hash: "#skills", label: t.skills, key: "skills" },
  { hash: "#lab", label: t.lab, key: "lab" },
  { hash: "#contact", label: t.contact, key: "contact" },
];

// The pill switches to the same page in the other locale, so the reader never
// gets dumped back on the home page just for changing language.
const otherLocale = locales.find((l) => l !== locale) ?? defaultLocale;
const otherHref = localizePath(path, otherLocale);
---

<nav class="nav" data-nav-root>
  <div class="container nav-inner">
    <a href={`${home}${links[0].hash}`} class="brand">
      <img src="/img/dbh2-white.svg" alt={t.brandAlt} class="brand-logo logo-dark" />
      <img src="/img/dbh2-black.svg" alt={t.brandAlt} class="brand-logo logo-light" />
      <span class="brand-name">Diego Barrio H.</span>
    </a>

    <div class="nav-panel" id="primary-menu">
      <div class="nav-links">
        {links.map((l) => (
          <a href={`${home}${l.hash}`} class={current === l.key ? "active" : ""}>{l.label}</a>
        ))}
      </div>
    </div>

    <div class="nav-actions">
      <a class="btn primary nav-cv" href={localizePath("/cv/", locale)} aria-label={t.cv}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
          <polyline points="14 2 14 8 20 8" />
          <line x1="16" y1="13" x2="8" y2="13" />
          <line x1="16" y1="17" x2="8" y2="17" />
        </svg>
        {t.cv}
      </a>
      <a class="toggle lang-toggle" href={otherHref} hreflang={otherLocale} aria-label={t.langToggle}>
        <span class="opt" data-value="es">ES</span>
        <span class="opt" data-value="en">EN</span>
      </a>
      <button class="toggle theme-toggle" type="button" id="theme-toggle" aria-label={t.themeToggle}>
        <span class="opt" data-value="light">☀</span>
        <span class="opt" data-value="dark">☾</span>
      </button>
    </div>

    <button
      class="menu-toggle"
      type="button"
      data-menu-toggle
      aria-expanded="false"
      aria-controls="primary-menu"
      aria-label={t.menuOpen}
      data-label-open={t.menuOpen}
      data-label-close={t.menuClose}
    >
      <span class="menu-toggle-line"></span>
      <span class="menu-toggle-line"></span>
      <span class="menu-toggle-line"></span>
    </button>
  </div>
</nav>

<script is:inline>
  const nav = document.querySelector("[data-nav-root]");

  if (nav) {
    const toggleButton = nav.querySelector("[data-menu-toggle]");
    const navLinks = nav.querySelectorAll(".nav-links a");

    const setExpanded = (expanded) => {
      nav.classList.toggle("is-open", expanded);
      if (toggleButton) {
        toggleButton.setAttribute("aria-expanded", expanded ? "true" : "false");
        toggleButton.setAttribute(
          "aria-label",
          expanded ? toggleButton.dataset.labelClose : toggleButton.dataset.labelOpen
        );
      }
    };

    toggleButton?.addEventListener("click", () => {
      setExpanded(!nav.classList.contains("is-open"));
    });

    navLinks.forEach((link) => {
      link.addEventListener("click", () => {
        setExpanded(false);
      });
    });

    window.addEventListener("resize", () => {
      if (window.innerWidth > 820) {
        setExpanded(false);
      }
    });
  }
</script>
